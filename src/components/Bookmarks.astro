---
---
<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code> to generate its short <code>mona-</code> slug.</p>
  <p id="bookmark-status" class="bookmark-status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    createSlug,
    formatBookmark,
    normalizeUrl,
    parseStoredBookmarks,
    STORAGE_KEY,
  } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearButton = document.getElementById('clear-all');
  const status = document.getElementById('bookmark-status');

  let bookmarks = [];

  function showStatus(message, isError = false) {
    status.textContent = message;
    status.classList.toggle('is-error', isError);
  }

  function persist(nextBookmarks) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      showStatus('Bookmarks could not be saved in this browser. Check your storage settings.', true);
      return false;
    }
  }

  function render() {
    list.replaceChildren();
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`${bookmark.slug} copied to clipboard.`);
        } catch {
          showStatus('Could not access the clipboard. Select and copy the slug instead.', true);
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      const url = normalizeUrl(input.value);
      const slug = createSlug(bookmarks.map((bookmark) => bookmark.slug));
      const nextBookmarks = [...bookmarks, { url, slug }];

      if (persist(nextBookmarks)) {
        bookmarks = nextBookmarks;
        input.value = '';
        showStatus(`Saved ${formatBookmark({ url, slug })}.`);
        render();
      }
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Enter a valid web address.', true);
    }
  });

  clearButton?.addEventListener('click', () => {
    if (bookmarks.length && window.confirm('Clear all saved bookmarks?') && persist([])) {
      bookmarks = [];
      showStatus('All bookmarks cleared.');
      render();
    }
  });

  try {
    bookmarks = parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch {
    bookmarks = [];
    showStatus('Saved bookmarks are unavailable in this browser.', true);
  }
  render();
</script>

<style is:global>
  .bookmark-manager {
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    border-radius: 1rem;
    background:
      radial-gradient(ellipse at top right, color-mix(in srgb, var(--accent) 12%, transparent), transparent 55%),
      color-mix(in srgb, Canvas 94%, var(--accent));
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }
  .bookmark-manager form { margin-top: 0; }
  .bookmark-manager input {
    min-height: 2.9rem;
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    background: color-mix(in srgb, Canvas 86%, transparent);
  }
  .bookmark-manager input:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .bookmark-manager form > button { min-height: 2.9rem; }
  .bookmark-manager .hint { margin-bottom: 1rem; }
  .bookmark-manager .bookmark-status {
    min-height: 1.25rem;
    margin: -0.5rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .bookmark-manager .bookmark-status:empty { display: none; }
  .bookmark-manager .bookmark-status.is-error { color: #dc2626; }
  .bookmark-manager [hidden] { display: none !important; }
  .bookmark-manager .bookmark {
    gap: 0.45rem;
    padding: 0.8rem;
    border-color: color-mix(in srgb, var(--accent) 16%, var(--border));
    background: color-mix(in srgb, Canvas 78%, transparent);
  }
  .bookmark-manager .bookmark .url { color: inherit; }
  .bookmark-manager .bookmark .separator { white-space: pre; color: var(--muted); }
  .bookmark-manager .bookmark .slug {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .bookmark-manager .bookmark .copy { margin-left: auto; }
  .bookmark-manager .empty {
    border-color: color-mix(in srgb, var(--accent) 28%, var(--border));
    background: color-mix(in srgb, Canvas 70%, transparent);
  }
  @media (max-width: 32rem) {
    .bookmark-manager { padding: 1rem; }
    .bookmark-manager form > button { width: 100%; }
  }
</style>
